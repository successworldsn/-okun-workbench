/*
 * geye.successagenticlabs.com — God's Eye, served the same way as the
 * successagenticlabs.com apex: an ASSETS-ONLY Worker (no script, no bindings).
 * Cloudflare serves ./public directly.
 *
 *   /        Capital Desk on the live public Georgia infrastructure feed
 *   /deals   Deal Desk on fictional EXAMPLE properties (real Atlanta records
 *            hold owner names and never go to a public URL)
 *
 * Same pattern as opticom.successagenticlabs.com and dawgman.successagenticlabs.com
 * (account df84774bba1198ab9b93ba0901ab0073, thothestates; Free plan). Deploy
 * from the laptop with wrangler's stored OAuth login and the vendored wrangler
 * (the .cmd shim breaks on the space in "Genius Laude"):
 *
 *   node deploy/geye/build-site.mjs
 *   cd deploy/geye
 *   node ../../../success-agentic-labs/node_modules/wrangler/bin/wrangler.js deploy --env staging   (optional test copy)
 *   node ../../../success-agentic-labs/node_modules/wrangler/bin/wrangler.js deploy
 *
 * Then record "LIVE <date>, version <id>; rollback <previous id>" in memory.
 * CI (.github/workflows/geye-deploy.yml) deploys only if the repo has
 * CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID secrets; it is off by default.
 */
{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "godseye",
	"compatibility_date": "2026-07-11",

	"assets": {
		"directory": "./public",
		// /deals serves deals.html; /deals.html 307s to /deals.
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "none"
	},

	"observability": { "enabled": false },

	// Backup URL, as on opticom-site: godseye.thothestates.workers.dev
	"workers_dev": true,
	"preview_urls": false,

	// A Workers Custom Domain on the successagenticlabs.com zone. Cloudflare
	// creates the DNS record and certificate on the first deploy.
	"routes": [{ "pattern": "geye.successagenticlabs.com", "custom_domain": true }],

	// Test copy, as opticom-site-staging: workers.dev only, no custom domain.
	//   godseye-staging.thothestates.workers.dev
	"env": {
		"staging": { "name": "godseye-staging", "routes": [], "workers_dev": true }
	}
}
